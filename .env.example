# Copy to .env only to override — compose defaults work without any editing.

# --- Application ---
PORT=3000
APP_PORT=3000
# Seat hold time-to-live. Judges may run the stack with a short value, e.g. 5.
HOLD_TTL_SECONDS=120
# Safety window for a booking stuck in PAYMENT_PENDING with no gateway callback.
PAYMENT_PENDING_TIMEOUT_SECONDS=600
# How often the expiry sweeper runs.
SWEEP_INTERVAL_SECONDS=5
# Max PostgreSQL connections per app instance.
PGPOOL_MAX=20

# --- Database ---
POSTGRES_USER=cinemaseat
POSTGRES_PASSWORD=cinemaseat
POSTGRES_DB=cinemaseat
# Host port the compose db publishes (containers always use db:5432).
POSTGRES_HOST_PORT=5433
# In-compose address. From the host use localhost:5433.
DATABASE_URL=postgres://cinemaseat:cinemaseat@db:5432/cinemaseat

# --- Payment/OTP gateway (provided mock) ---
GATEWAY_URL=http://gateway:9000
GATEWAY_TIMEOUT_MS=3000
# URL the gateway calls back. Must be reachable FROM the gateway container →
# Docker service DNS, never localhost. In deployment set the public URL.
PUBLIC_CALLBACK_URL=http://app:3000/api/payments/callback
# HMAC secret for callback signatures (gateway default).
GATEWAY_SECRET=z2p-2026-secret
# off | log | enforce (enforce = reject callbacks with a bad HMAC signature)
GATEWAY_SIGNATURE_MODE=enforce
# Payment requires a verified OTP first (set false only for local debugging).
OTP_REQUIRED=true
