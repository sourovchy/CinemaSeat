# CinemaSeat Frontend Environment Variables
# Copy this file to .env.local and fill in your values.

# Optional API base URL override (defaults to relative /api which proxies to http://127.0.0.1:3000 in dev)
# VITE_API_BASE_URL=http://127.0.0.1:3000/api

# TMDB API key for movie poster/backdrop enrichment.
# Get a free key at: https://www.themoviedb.org/settings/api
# NOTE: VITE_* variables are exposed to the browser — this is NOT a secret.
# For production, consider proxying TMDB requests through a server-side API.
VITE_TMDB_API_KEY=

